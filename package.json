{
  "name": "pinpals",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "prebuild:android": "expo prebuild --platform android --clean",
    "prebuild:clean": "expo prebuild --clean",
    "ios:device": "expo run:ios --device",
    "ios:device:clean": "expo prebuild --platform ios --clean && expo run:ios --device",
    "android:device": "expo run:android --device",
    "android:device:clean": "expo prebuild --platform android --clean && expo run:android --device",
    "develop:ios": "expo run:ios",
    "develop:ios:clean": "expo prebuild --platform ios --clean && expo run:ios",
    "develop:android": "expo run:android",
    "develop:android:clean": "expo prebuild --platform android --clean && expo run:android",
    "lint": "eslint src --max-warnings 0",
    "format:check": "prettier --check src",
    "format:fix": "prettier --write src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "compilerOptions": {
    "strict": true
  },
  "dependencies": {
    "@expo/ui": "^57.0.7",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/auth": "^24.0.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@rnmapbox/maps": "^10.1.32",
    "expo": "^57.0.7",
    "expo-build-properties": "^57.0.6",
    "expo-constants": "^57.0.6",
    "expo-dev-client": "^57.0.7",
    "expo-device": "^57.0.1",
    "expo-font": "^57.0.1",
    "expo-glass-effect": "^57.0.1",
    "expo-image": "^57.0.1",
    "expo-image-picker": "^57.0.5",
    "expo-linking": "^57.0.3",
    "expo-location": "^57.0.5",
    "expo-router": "^57.0.7",
    "expo-splash-screen": "^57.0.4",
    "expo-status-bar": "^57.0.1",
    "expo-symbols": "^57.0.1",
    "expo-system-ui": "^57.0.1",
    "expo-web-browser": "^57.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.0",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-reanimated": "^4.5.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.10.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.2",
    "prettier": "^3.8.2",
    "react-test-renderer": "^19.2.7",
    "sort-package-json": "^4.0.0",
    "typescript": "^6.0.3"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-worklets"
      ]
    }
  }
}
