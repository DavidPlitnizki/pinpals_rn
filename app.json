{
  "expo": {
    "name": "Pinpals",
    "slug": "pinpals",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pinpals",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.dpdevstudio.pinpals",
      "googleServicesFile": "./GoogleService-Info.plist",
      "deploymentTarget": "17.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "HGV5G3PM9X"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#4A7C59"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dpstudio.pinpals",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@rnmapbox/maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Pinpals to use your location to centre the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Pinpals to access your photo library to add photos to your places.",
          "cameraPermission": "Allow Pinpals to use your camera to take photos of your places."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8f4aa",
          "image": "./assets/images/splash-screen.png",
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-build-properties",
      "./plugins/withModularHeaders",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.679174491874-hala7k0hd1ve0v7p9vmn842hm32ful94"
        }
      ],
      "expo-apple-authentication",
      "@react-native-firebase/analytics"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "01f09958-0a03-4caa-8b93-d142286345a1"
      }
    }
  }
}
