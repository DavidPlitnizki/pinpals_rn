{
  "expo": {
    "name": "Pinpals",
    "slug": "pinpals",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pinpals",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.dpdevstudio.pinpals",
      "googleServicesFile": "./GoogleService-Info.plist",
      "deploymentTarget": "17.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "HGV5G3PM9X"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#4A7C59"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dpstudio.pinpals",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@rnmapbox/maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pinpals uses your location to center the map on your area, get directions to places, and show live turn-by-turn navigation while you're on the way.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "motionUsagePermission": "Pinpals uses motion data to improve the accuracy of your location while you're getting directions."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pinpals uses your photo library so you can choose existing photos for your profile picture and for your places and memories.",
          "cameraPermission": "Pinpals uses your camera to take photos for your profile picture and for your places and memories.",
          "microphonePermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Pinpals uses your contacts so you can pick who you were with from your address book instead of typing every name. Only names are read — never phone numbers or emails — and they stay on this device."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8f4aa",
          "image": "./assets/images/splash-screen.png",
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-build-properties",
      "./plugins/withModularHeaders",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.679174491874-hala7k0hd1ve0v7p9vmn842hm32ful94"
        }
      ],
      "expo-apple-authentication",
      "@react-native-firebase/analytics",
      "@react-native-firebase/crashlytics"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "01f09958-0a03-4caa-8b93-d142286345a1"
      }
    }
  }
}
